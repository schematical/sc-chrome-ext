{
  "manifest_version": 3,
  "name": "Schematical",
  "version": "1.0",
  "description": "Add the reading time to Chrome Extension documentation articles",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "contextMenus",
    "notifications"
  ],
  "action": {
    "default_popup": "menu.html",
    "default_icon": "images/icon.png"
  },
  "options_page": "settings.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": ["main.js"],
      "matches": ["https://*.console.aws.amazon.com/*"],
      "run_at": "document_end"
    },
    {
      "js": ["main.js"],
      "matches": ["https://www.customwheeloffset.com/*"],
      "run_at": "document_end"
    },
    {
      "js": ["customWheelOffsetWidget.js"],
      "matches": ["https://www.customwheeloffset.com/*"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vehicle-gallery.html",
        "chat-widget.html",
        "chat-widget.js",
        "images/SchematicalSticker.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
