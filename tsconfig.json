{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "target": "es6",
    "esModuleInterop": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "noEmitOnError": true,
    "typeRoots": [
      "node_modules/@types"
    ]
  },
  "exclude": [
    "_sample/**/*",
    "node_modules/**/*",
    "dist/**/*"
  ]
}